# Copy this file to `.env` (same directory, no `.example` suffix) and fill
# in the secrets you actually need. The backend auto-loads `.env` at start
# without overwriting variables already set in your shell.
#
# .env is gitignored — keys never leave your machine.

# ---------------------------------------------------------------------------
# LLM providers — only needed for Stage 3 classification.
# ---------------------------------------------------------------------------

# OpenAI (default Stage 3 provider). Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic (alternative provider).
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Optional overrides — leave commented unless you actually need them.
# ---------------------------------------------------------------------------

# TAGFORGE_HOST=127.0.0.1
# TAGFORGE_PORT=9301
# Accepted Host headers (DNS-rebinding defense). Binding 0.0.0.0 for LAN
# access means adding the IP/name you actually browse to. "*" disables it.
# TAGFORGE_ALLOWED_HOSTS=127.0.0.1,localhost
# TAGFORGE_DB_PATH=C:\path\to\tagforge.db
# TAGFORGE_DEV_ORIGIN=http://localhost:9300
# TAGFORGE_REQ_PER_SECOND=5
# TAGFORGE_USER_AGENT=TagForge/0.1 (local-tool)

# Proxy for booru fetches, for networks where boorus are unreachable
# directly (probed at fetch time; falls back to a direct connection).
# TAGFORGE_BOORU_PROXY=socks5://127.0.0.1:40000

# Local LLM via llama-swap (NAI prompt splitter). URL of a running server;
# BAT/CONFIG only power the in-app "start server" button and idle-TTL knob.
# TAGFORGE_LLAMA_SWAP_URL=http://127.0.0.1:8080
# TAGFORGE_LLAMA_SWAP_BAT=C:\path\to\start-llama-swap.bat
# TAGFORGE_LLAMA_SWAP_CONFIG=C:\path\to\llama-swap\config.yaml

# See-through decomposition (Decompose tab) — python env + repo checkouts.
# TAGFORGE_SEETHROUGH_PYTHON=C:\path\to\envs\see_through\python.exe
# TAGFORGE_SEETHROUGH_DIR=C:\path\to\see-through
# TAGFORGE_SEETHROUGH_LAYERDIFF=C:\path\to\seethrough_layerdiff3d
# TAGFORGE_SEETHROUGH_DEPTH=C:\path\to\seethrough_marigold

# UI hint for the ingest page's "latest metadata dump" shortcut.
# TAGFORGE_METADATA_FILE=C:\path\to\metadata.txt

# Sibling Kohaku-NAI checkout (optional export targets + tag database).
# TAGFORGE_KOHAKU_TAGS_JSONL=C:\path\to\Kohaku-NAI\DATASET\danbooru-tags\tags.jsonl
# TAGFORGE_KOHAKU_WILDCARDS_DIR=C:\path\to\Kohaku-NAI\client_extensions\kohaku-nai-wildcards\wildcards
# TAGFORGE_KOHAKU_COMMON_PROMPTS_DIR=C:\path\to\Kohaku-NAI\Common Dynamic Prompts

# Wildcard export output root (default: ./exports).
# TAGFORGE_EXPORTS_DIR=C:\path\to\exports
